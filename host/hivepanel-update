#!/usr/bin/env bash
set -Eeuo pipefail
umask 0077
INSTALL_DIR="${HIVEPANEL_INSTALL_DIR:-/opt/hivepanel}"
COMMON="${HIVEPANEL_COMMON:-/usr/local/lib/hivepanel/hivepanel-common.sh}"
source "$COMMON"
REQUEST_FILE="$INSTALL_DIR/runtime/update-request.json"
STATUS_FILE="$INSTALL_DIR/runtime/update-status.json"
VERSION=""
BACKUP_FILE=""
CLAIMED=false
MAINTENANCE=false
PHASE="preflight"
finish() {
    local result=$?
    trap - EXIT
    if [[ "$CLAIMED" == true ]]; then
        if [[ "$MAINTENANCE" == true ]]; then
            docker compose exec -T panel php artisan up >/dev/null 2>&1 || true
        fi
        if (( result != 0 )); then
            status failed "Update failed during ${PHASE}. See journalctl -u hivepanel-update.service. The request and any database backup are retained; submit a new request to retry." || true
        fi
    fi
    exit "$result"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cd "$INSTALL_DIR"
mkdir -p runtime backups backups/update-history
chmod 0700 backups backups/update-history
exec 9>backups/update.lock
# Wait rather than exit: a pending PathExists request must not cause a busy loop.
flock 9
[[ -f "$REQUEST_FILE" ]] || exit 0
[[ ! -L "$REQUEST_FILE" ]] || { rm -f "$REQUEST_FILE"; exit 1; }
REQUEST_ARCHIVE="$(mktemp "$INSTALL_DIR/backups/update-history/request-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX.json")"
mv -f "$REQUEST_FILE" "$REQUEST_ARCHIVE"
CLAIMED=true
[[ ! -L "$REQUEST_ARCHIVE" ]] || exit 1
chmod 0600 "$REQUEST_ARCHIVE"
VERSION="$(python3 "$HOST_HELPER" version "$REQUEST_ARCHIVE")"
CURRENT_VERSION="$(env_value HIVEPANEL_VERSION)"
[[ "$CURRENT_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)(\.[0-9]+)?)?$ ]]
python3 "$HOST_HELPER" validate-env .env
docker compose config --quiet
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)-$$"
BACKUP_FILE="$INSTALL_DIR/backups/hivepanel-${CURRENT_VERSION}-${TIMESTAMP}.sql.gz"
PHASE="database backup"
status backing_up "Creating a database backup before updating."
# Read credentials inside the database container; do not expose them in host argv.
if ! docker compose exec -T mariadb sh -ec 'export MYSQL_PWD="${MARIADB_ROOT_PASSWORD:-${MYSQL_ROOT_PASSWORD:-}}"; test -n "$MYSQL_PWD"; exec mariadb-dump -uroot --single-transaction --quick --lock-tables=false "${MARIADB_DATABASE:-${MYSQL_DATABASE:-hivepanel}}"' | gzip > "${BACKUP_FILE}.partial"; then
    exit 1
fi
gzip -t "${BACKUP_FILE}.partial"
mv "${BACKUP_FILE}.partial" "$BACKUP_FILE"
cp -p .env "backups/env-${TIMESTAMP}.bak"
cp -p compose.yaml "backups/compose-${TIMESTAMP}.yaml"
PHASE="image download"
status pulling "Downloading HivePanel v${VERSION}; preserving the existing Compose configuration."
# Keep host port bindings, mounts, project name and local deployment customisations.
HIVEPANEL_VERSION="$VERSION" docker compose config --quiet
HIVEPANEL_VERSION="$VERSION" docker compose pull panel queue scheduler nginx
PHASE="application startup"
MAINTENANCE=true
docker compose exec -T panel php artisan down --retry=30
python3 "$HOST_HELPER" set-version .env "$VERSION"
export HIVEPANEL_VERSION="$VERSION"
status restarting "Starting the new HivePanel application container."
docker compose up -d --no-deps panel
for attempt in $(seq 1 30); do
    docker compose exec -T panel php artisan about >/dev/null 2>&1 && break
    [[ "$attempt" -lt 30 ]] || exit 1
    sleep 2
done
PHASE="database migrations"
status migrating "Running database migrations and rebuilding application caches."
docker compose exec -T panel php artisan migrate --force
docker compose exec -T panel php artisan optimize:clear
docker compose exec -T panel php artisan optimize
PHASE="service startup"
status restarting "Starting application services and refreshing Nginx."
docker compose up -d --no-deps panel queue scheduler nginx
# Compose only replaces Nginx when its image/config changed. Reload resolves the
# new panel address when its existing container was kept.
refresh_nginx
docker compose exec -T panel php artisan up
MAINTENANCE=false
PHASE="HTTP health check"
for attempt in $(seq 1 60); do
    health_check && break
    [[ "$attempt" -lt 60 ]] || exit 1
    sleep 2
done
PHASE="installation metadata"
if [[ -f runtime/installation.json ]]; then
    python3 "$HOST_HELPER" metadata runtime/installation.json "$VERSION"
fi
status complete "HivePanel was updated successfully to v${VERSION}."
